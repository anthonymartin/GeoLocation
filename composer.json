{
    "name": "anthonymartin/geo-location",
    "type": "library",
    "description": "Powerful GeoCoding library: Retrieve bounding box coordinates, distances between geopoints, point in polygon, get longitude and latitude from addresses and more with GeoLocation for PHP",
    "keywords": [
        "geolocation",
        "geocoding",
        "bounding coordinates",
        "bounding box coordinates",
        "distances",
        "geocode",
        "latitude",
        "longitude",
        "point in polygon"
    ],
    "homepage": "https://github.com/anthonymartin/GeoLocation",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Martin",
            "email": "anthony@replaycreative.com",
            "homepage": "http://replaycreative.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "AnthonyMartin\\GeoLocation\\": "src/AnthonyMartin/GeoLocation/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "deptrac/deptrac": "^4.7",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "nyholm/psr7": "^1.8"
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests",
        "test:no-bcmath": "@php -n tests/without-bcmath.php",
        "analyse": "phpstan analyse --no-progress",
        "test:readme": "@php tests/readme-examples.php",
        "architecture": [
            "deptrac analyse --config-file=deptrac.yaml --no-progress --fail-on-uncovered",
            "@php tools/check-core-purity.php"
        ],
        "lint": [
            "@analyse",
            "@architecture"
        ]
    },
    "suggest": {
        "ext-curl": "Default geocoding transport; unnecessary when injecting a PSR-18 client.",
        "psr/http-client": "Optional PSR-18 client contract for injected HTTP transports.",
        "psr/http-factory": "Optional PSR-17 request/response factories for injected HTTP transports.",
        "guzzlehttp/guzzle": "An optional PSR-18 client; supply its PSR-17 request factory too.",
        "symfony/http-client": "An optional PSR-18 client adapter; supply a PSR-17 request factory too."
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
