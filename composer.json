{
    "name": "anthonymartin/geo-location",
    "type": "library",
    "description": "Powerful GeoCoding library: Retrieve bounding box coordinates, distances between geopoints, point in polygon, get longitude and latitude from addresses and more with GeoLocation for PHP",
    "keywords": [
        "geolocation",
        "geocoding",
        "bounding coordinates",
        "bounding box coordinates",
        "distances",
        "geocode",
        "latitude",
        "longitude",
        "point in polygon"
    ],
    "homepage": "https://github.com/anthonymartin/GeoLocation",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Martin",
            "email": "anthony@replaycreative.com",
            "homepage": "http://replaycreative.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "AnthonyMartin\\GeoLocation\\": "src/AnthonyMartin/GeoLocation/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests",
        "test:no-bcmath": "@php -n tests/without-bcmath.php"
    },
    "suggest": {
        "ext-curl": "Required only by GoogleGeocoder; geometry has no cURL dependency."
    }
}
